    "Everything left in the wood since 1911, catalogued — and the catalogue is the problem.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تُرك في الغابة منذ 1911 مُفهرس — والفهرس هو المشكلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was seit 1911 im Wald zurückgelassen wurde, katalogisiert — und der Katalog ist das Problem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything left in the wood since 1911, catalogued — and the catalogue is the problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo dejado en el bosque desde 1911, catalogado — y el catálogo es el problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui a été laissé dans le bois depuis 1911, catalogué — et le catalogue est le problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è stato lasciato nel bosco dal 1911, catalogato — e il catalogo è il problema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo que foi deixado no bosque desde 1911, catalogado — e o catálogo é o problema."
          }
        }
      }
    },
