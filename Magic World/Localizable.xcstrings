    "Every evening for a week they draw the same coastline, and it is not this one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every evening for a week they draw the same coastline, and it is not this one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite por uma semana eles desenham a mesma costa, e não é esta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche durante una semana dibujan la misma costa, y no es esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque soir pendant une semaine ils dessinent la même côte, et ce n’est pas celle-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Abend eine Woche lang zeichnen sie dieselbe Küstenlinie, und es ist nicht diese."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sera per una settimana disegnano la stessa costa, e non è questa."
