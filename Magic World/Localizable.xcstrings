    "The bridge fell in 1998. For one night in June you can still see where it was.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge fell in 1998. For one night in June you can still see where it was."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ponte caiu em 1998. Por uma noite de junho ainda dá para ver onde ficava."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente cayó en 1998. Una noche de junio aún puedes ver dónde estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont est tombé en 1998. Une nuit de juin, on voit encore où il était."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Brücke stürzte 1998 ein. Eine Nacht im Juni sieht man noch, wo sie stand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ponte è caduto nel 1998. Per una notte di giugno si vede ancora dov’era."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سقط الجسر عام 1998. في ليلة واحدة من يونيو لا يزال بإمكانك رؤية موضعه."
          }
        }
      }
    },
