    "There is a bright patch by the bus stop that has been bright for forty years.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a bright patch by the bus stop that has been bright for forty years."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma mancha brilhante perto do ponto de ônibus que brilha há quarenta anos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una mancha brillante junto a la parada de autobús que lleva brillando cuarenta años."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une tache lumineuse près de l’arrêt de bus qui brille depuis quarante ans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neben der Bushaltestelle gibt es einen hellen Fleck, der seit vierzig Jahren leuchtet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è una macchia luminosa vicino alla fermata dell’autobus, luminosa da quarant’anni."
