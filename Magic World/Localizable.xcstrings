    "The lane to the mill was closed in 1890. The boar still uses it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق الدرب المؤدي إلى الطاحونة عام 1890. لا يزال الخنزير البرّي يستخدمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weg zur Mühle wurde 1890 geschlossen. Der Keiler benutzt ihn immer noch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lane to the mill was closed in 1890. The boar still uses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sendero al molino se cerró en 1890. El jabalí aún lo usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sentier vers le moulin a été fermé en 1890. Le sanglier l’emprunte toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sentiero verso il mulino è stato chiuso nel 1890. Il cinghiale lo usa ancora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A trilha até o moinho foi fechada em 1890. O javali ainda usa."
          }
        }
      }
    },
