    "Ines finds the attic full of pale moths, and every one of them is holding a dream that somebody forgot.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجد إينيس العلّية مليئة بفراشات شاحبة، وكلٌّ منها تحمل حلمًا نسيه أحدهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines findet den Dachboden voller blasser Motten, und jede hält einen Traum, den jemand vergessen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines finds the attic full of pale moths, and every one of them is holding a dream that somebody forgot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inés encuentra el ático lleno de polillas pálidas, y cada una sostiene un sueño que alguien olvidó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inès trouve le grenier plein de papillons pâles, et chacun tient un rêve que quelqu’un a oublié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines trova la soffitta piena di falene pallide, e ognuna regge un sogno che qualcuno ha dimenticato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines encontra o sótão cheio de mariposas pálidas, e cada uma segura um sonho que alguém esqueceu."
          }
        }
      }
    },
    "It arrives. It is not signed. You are never going to find out who.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي. غير موقّع. لن تعرف قط ممّن هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommt an. Sie ist nicht unterschrieben. Du wirst nie erfahren, von wem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It arrives. It is not signed. You are never going to find out who."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega. No está firmada. Nunca vas a saber de quién."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle arrive. Elle n’est pas signée. Tu ne sauras jamais de qui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivano. Non sono firmate. Non saprai mai da chi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chega. Não está assinado. Você nunca vai descobrir de quem."
          }
        }
      }
    },
    "It is full by August, and in September it has to be emptied somewhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمتلئ بحلول أغسطس، وفي سبتمبر يجب تفريغها في مكان ما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis August ist es voll, und im September muss es irgendwo geleert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is full by August, and in September it has to be emptied somewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está llena para agosto, y en septiembre hay que vaciarla en alguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est pleine en août, et en septembre il faut la vider quelque part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È piena entro agosto, e a settembre va svuotata da qualche parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está cheia até agosto, e em setembro precisa ser esvaziada em algum lugar."
          }
        }
      }
    },
    "It moved on a still Thursday, and the whole town watched it move.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرّك في خميسٍ ساكن، وشاهدته البلدة كلها يتحرّك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bewegte sich an einem windstillen Donnerstag, und die ganze Stadt sah es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moved on a still Thursday, and the whole town watched it move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se movió un jueves sin viento, y toda la ciudad lo vio moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a bougé un jeudi sans vent, et toute la ville l’a vue bouger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è mossa un giovedì senza vento, e tutta la città l’ha vista muoversi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele se moveu numa quinta parada, e a cidade inteira o viu se mover."
          }
        }
      }
    },
    "It never comes when you call it, and it is always there when you are frightened.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يأتي أبدًا حين تناديه، ويكون هناك دائمًا حين تخاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommt nie, wenn du sie rufst, und ist immer da, wenn du Angst hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never comes when you call it, and it is always there when you are frightened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca viene cuando lo llamas, y siempre está ahí cuando tienes miedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne vient jamais quand tu l’appelles, et il est toujours là quand tu as peur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene mai quando lo chiami, ed è sempre lì quando hai paura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele nunca vem quando você chama, e está sempre lá quando você está com medo."
          }
        }
      }
    },
    "It says hers out loud on the landing, and she has not told a single person at that school.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوله بصوت عالٍ في بسطة الدرج، ولم تخبر أحدًا في تلك المدرسة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sagt ihren laut auf dem Treppenabsatz, und sie hat es keinem an dieser Schule erzählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It says hers out loud on the landing, and she has not told a single person at that school."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice en voz alta en el descansillo, y ella no se lo ha contado a nadie en esa escuela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle le dit à voix haute sur le palier, et elle ne l’a dit à personne à cette école."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice ad alta voce sul pianerottolo, e lei non l’ha detto a nessuno in quella scuola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela diz o dela em voz alta no patamar da escada, e ela não contou pra ninguém naquela escola."
          }
        }
      }
    },
    "Joaquim is losing his sight, and the bat is the first thing in that house that does not talk around it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفقد جواكيم بصره، والخفّاش هو أول شيء في ذلك البيت لا يلفّ حول الموضوع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim verliert sein Augenlicht, und die Fledermaus ist das Erste in dem Haus, das nicht um das Thema herumredet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim is losing his sight, and the bat is the first thing in that house that does not talk around it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim está perdiendo la vista, y el murciélago es lo primero en esa casa que no se anda con rodeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim perd la vue, et la chauve-souris est la première chose dans cette maison qui ne tourne pas autour du sujet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim sta perdendo la vista, e il pipistrello è la prima cosa in quella casa che non gira attorno al punto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim está perdendo a visão, e o morcego é a primeira coisa naquela casa que não fica dando voltas."
          }
        }
      }
    },
    "Just arrived": {
