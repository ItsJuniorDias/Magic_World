    "One reminder a day, at the hour you pick. Nothing else — no streaks to protect, no badges chasing you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير واحد يوميًا، في الوقت الذي تختاره. لا شيء آخر — لا سلاسل عليك حمايتها ولا شارات تلاحقك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung am Tag, zur von dir gewählten Uhrzeit. Sonst nichts — keine Serien zu schützen, keine Abzeichen, die dich jagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reminder a day, at the hour you pick. Nothing else — no streaks to protect, no badges chasing you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso al día, a la hora que elijas. Nada más: sin rachas que cuidar, sin insignias detrás de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel par jour, à l’heure de ton choix. Rien d’autre : pas de séries à préserver, pas de badges qui te courent après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria al giorno, all’ora che scegli tu. Niente altro: nessuna serie da mantenere, nessun distintivo che ti insegue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete por dia, na hora que você escolher. Nada mais — sem sequências pra proteger, sem selos te perseguindo."
          }
        }
      }
    },
    "One subscription covers everyone in your family group.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراك واحد يغطي كل أفراد مجموعتك العائلية."
          }
        },
        "de": {
          "stringUnit": {
