    "Kenna walks north to ask him to stand somewhere else, which is not how any of it works.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمشي كِنا شمالًا لتطلب منه أن يقف في مكان آخر، وليست هكذا يعمل أيّ من هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna geht nach Norden, um ihn zu bitten, sich woanders hinzustellen — was so aber überhaupt nicht funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna walks north to ask him to stand somewhere else, which is not how any of it works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna camina hacia el norte para pedirle que se ponga en otro sitio, y no es así como funciona nada de esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna marche vers le nord pour lui demander de se tenir ailleurs, ce qui n’est pas du tout comme ça que ça marche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna cammina verso nord per chiedergli di stare da un’altra parte, cosa che non funziona così."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenna caminha para o norte para pedir que ele fique em outro lugar, o que não é como nada disso funciona."
          }
        }
      }
    },
