    "Ines finds the attic full of pale moths, and every one of them is holding a dream that somebody forgot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines finds the attic full of pale moths, and every one of them is holding a dream that somebody forgot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines encontra o sótão cheio de mariposas pálidas, e cada uma segura um sonho que alguém esqueceu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inés encuentra el ático lleno de polillas pálidas, y cada una sostiene un sueño que alguien olvidó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inès trouve le grenier plein de papillons pâles, et chacun tient un rêve que quelqu’un a oublié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines findet den Dachboden voller blasser Motten, und jede hält einen Traum, den jemand vergessen hat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ines trova la soffitta piena di falene pallide, e ognuna regge un sogno che qualcuno ha dimenticato."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجد إينيس العلّية مليئة بفراشات شاحبة، وكلٌّ منها تحمل حلمًا نسيه أحدهم."
          }
        }
      }
    },
