    "Connect to the internet to download the narration (%@). You can keep reading meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the internet to download the narration (%@). You can keep reading meanwhile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se à internet para baixar a narração (%@). Você pode continuar lendo enquanto isso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a internet para descargar la narración (%@). Puedes seguir leyendo mientras tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte-toi à internet pour télécharger la narration (%@). Tu peux continuer à lire en attendant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit dem Internet, um die Erzählung (%@) zu laden. Du kannst inzwischen weiterlesen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a internet per scaricare la narrazione (%@). Nel frattempo puoi continuare a leggere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بالإنترنت لتنزيل السرد (%@). يمكنك متابعة القراءة في هذه الأثناء."
          }
        }
      }
    },
