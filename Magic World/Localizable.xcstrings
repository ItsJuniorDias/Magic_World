    "Joaquim is losing his sight, and the bat is the first thing in that house that does not talk around it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim is losing his sight, and the bat is the first thing in that house that does not talk around it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim está perdendo a visão, e o morcego é a primeira coisa naquela casa que não fica dando voltas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim está perdiendo la vista, y el murciélago es lo primero en esa casa que no se anda con rodeos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim perd la vue, et la chauve-souris est la première chose dans cette maison qui ne tourne pas autour du sujet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim verliert sein Augenlicht, und die Fledermaus ist das Erste in dem Haus, das nicht um das Thema herumredet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Joaquim sta perdendo la vista, e il pipistrello è la prima cosa in quella casa che non gira attorno al punto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفقد جواكيم بصره، والخفّاش هو أول شيء في ذلك البيت لا يلفّ حول الموضوع."
          }
        }
      }
    },
