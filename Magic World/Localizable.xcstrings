    "On the day she does not sing, the village finds out what the song was for.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the day she does not sing, the village finds out what the song was for."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No dia em que ela não canta, a aldeia descobre para o que servia o canto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día que no canta, el pueblo descubre para qué servía el canto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour où elle ne chante pas, le village découvre à quoi servait le chant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An dem Tag, an dem sie nicht singt, findet das Dorf heraus, wofür der Gesang war."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno che non canta, il paese scopre a cosa serviva il canto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في اليوم الذي لا تُغنّي فيه، تكتشف القرية لماذا كان الغناء."
          }
        }
      }
    },
