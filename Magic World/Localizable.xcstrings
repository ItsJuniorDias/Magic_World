    "Eight shelves, arranged by what the object was for — not by what it is.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثمانية رفوف مرتّبة بحسب ما كان الشيء يخدمه — لا بحسب ما هو عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Regale, geordnet nach dem, wofür der Gegenstand war — nicht danach, was er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight shelves, arranged by what the object was for — not by what it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho estantes, ordenados por para qué servía el objeto — no por qué es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit étagères, rangées par ce à quoi l’objet servait — pas par ce qu’il est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Otto mensole, disposte per l’uso che aveva l’oggetto — non per ciò che è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oito prateleiras, organizadas pelo para o que o objeto servia — não pelo que é."
          }
        }
      }
    },
