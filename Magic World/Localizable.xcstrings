    "Close the app and open it again for the new language to apply everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق ثم افتحه من جديد لتُطبَّق اللغة الجديدة في كل مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die App und öffne sie erneut, damit die neue Sprache überall greift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app and open it again for the new language to apply everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la app y ábrela otra vez para que el nuevo idioma se aplique en todos lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme l’app et rouvre-la pour que la nouvelle langue s’applique partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi l’app e riaprila perché la nuova lingua si applichi ovunque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o app e abra de novo para o novo idioma valer em toda parte."
          }
        }
      }
    },
