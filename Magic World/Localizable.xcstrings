    "Spring is four weeks late, and Tolek is the only one who goes up the mountain to find out why.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الربيع متأخر أربعة أسابيع، وتوليك هو الوحيد الذي يصعد الجبل ليعرف السبب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Frühling ist vier Wochen zu spät, und Tolek ist der Einzige, der auf den Berg steigt, um herauszufinden warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring is four weeks late, and Tolek is the only one who goes up the mountain to find out why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primavera lleva cuatro semanas de retraso, y Tolek es el único que sube a la montaña para averiguar por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le printemps a quatre semaines de retard, et Tolek est le seul à monter dans la montagne pour comprendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La primavera è in ritardo di quattro settimane, e Tolek è l’unico a salire in montagna per scoprire perché."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primavera está atrasada em quatro semanas, e Tolek é o único que sobe a montanha para descobrir por quê."
          }
        }
      }
    },
