    "Neither village has spoken to the other since 1974. The wolf goes to both.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكلّم أيّ من القريتين الأخرى منذ 1974. الذئب يذهب إلى كلتيهما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keines der beiden Dörfer spricht seit 1974 mit dem anderen. Der Wolf geht zu beiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither village has spoken to the other since 1974. The wolf goes to both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún pueblo le habla al otro desde 1974. El lobo va a los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun des deux villages n’a parlé à l’autre depuis 1974. Le loup va aux deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno dei due paesi parla all’altro dal 1974. Il lupo va da entrambi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma das aldeias fala com a outra desde 1974. O lobo vai às duas."
          }
        }
      }
    },
