    "Keeping": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاحتفاظ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping"
          }
        },
        "es": {
