    "Every family in the village tells the same story about the fire. The bird sings the rest of it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every family in the village tells the same story about the fire. The bird sings the rest of it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda família na aldeia conta a mesma história sobre o incêndio. O pássaro canta o resto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada familia del pueblo cuenta la misma historia del incendio. El pájaro canta el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque famille du village raconte la même histoire de l’incendie. L’oiseau chante le reste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Familie im Dorf erzählt dieselbe Geschichte vom Brand. Der Vogel singt den Rest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni famiglia del paese racconta la stessa storia sull’incendio. L’uccello canta il resto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
