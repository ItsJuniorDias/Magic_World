    "Elin sees the pond twice at once, and there is a boy on the far bank who is not there.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترى إيلين البركة مرّتين في آنٍ واحد، وثمة صبيّ على الضفة المقابلة ليس هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin sieht den Teich zweimal auf einmal, und am anderen Ufer steht ein Junge, der nicht da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin sees the pond twice at once, and there is a boy on the far bank who is not there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin ve el estanque dos veces a la vez, y hay un niño en la otra orilla que no está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin voit l’étang deux fois en même temps, et il y a un garçon sur l’autre rive qui n’est pas là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin vede lo stagno due volte allo stesso tempo, e c’è un ragazzo sulla riva opposta che non c’è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elin vê o lago duas vezes ao mesmo tempo, e há um menino na outra margem que não está lá."
          }
        }
      }
    },
