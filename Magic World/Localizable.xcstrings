    "It never comes when you call it, and it is always there when you are frightened.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never comes when you call it, and it is always there when you are frightened."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele nunca vem quando você chama, e está sempre lá quando você está com medo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca viene cuando lo llamas, y siempre está ahí cuando tienes miedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne vient jamais quand tu l’appelles, et il est toujours là quand tu as peur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommt nie, wenn du sie rufst, und ist immer da, wenn du Angst hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene mai quando lo chiami, ed è sempre lì quando hai paura."
