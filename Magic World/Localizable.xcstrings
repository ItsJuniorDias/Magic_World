    "Every child in the village has been told not to look. Sanna looks.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيل لكل طفل في القرية ألّا ينظر. سانّا تنظر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedem Kind im Dorf wurde gesagt, es solle nicht hinsehen. Sanna sieht hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every child in the village has been told not to look. Sanna looks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A todos los niños del pueblo se les ha dicho que no miren. Sanna mira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a dit à tous les enfants du village de ne pas regarder. Sanna regarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni bambino del paese è stato detto di non guardare. Sanna guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda criança na aldeia foi avisada para não olhar. Sanna olha."
          }
        }
      }
    },
    "Every evening for a week they draw the same coastline, and it is not this one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مساءٍ طوال أسبوع يرسمون الساحل نفسه، وهو ليس هذا الساحل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Abend eine Woche lang zeichnen sie dieselbe Küstenlinie, und es ist nicht diese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every evening for a week they draw the same coastline, and it is not this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada noche durante una semana dibujan la misma costa, y no es esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque soir pendant une semaine ils dessinent la même côte, et ce n’est pas celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sera per una settimana disegnano la stessa costa, e non è questa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda noite por uma semana eles desenham a mesma costa, e não é esta."
          }
        }
      }
    },
    "Every family in the village tells the same story about the fire. The bird sings the rest of it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل عائلة في القرية تروي القصة نفسها عن الحريق. الطائر يُغنّي بقيّتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Familie im Dorf erzählt dieselbe Geschichte vom Brand. Der Vogel singt den Rest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every family in the village tells the same story about the fire. The bird sings the rest of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada familia del pueblo cuenta la misma historia del incendio. El pájaro canta el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque famille du village raconte la même histoire de l’incendie. L’oiseau chante le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni famiglia del paese racconta la stessa storia sull’incendio. L’uccello canta il resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda família na aldeia conta a mesma história sobre o incêndio. O pássaro canta o resto."
          }
        }
      }
    },
    "Every fisherman in the bay has seen her once. None of them twice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صيّاد في الخليج رآها مرة. لا أحد رآها مرتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Fischer in der Bucht hat sie einmal gesehen. Keiner zweimal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every fisherman in the bay has seen her once. None of them twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los pescadores de la bahía la han visto una vez. Ninguno dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque pêcheur de la baie l’a vue une fois. Aucun deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pescatore della baia l’ha vista una volta. Nessuno due."
