    "He has been late three years running, and the herders have stopped pretending not to notice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأخّر ثلاث سنوات متتالية، وكفّ الرعاة عن التظاهر بعدم الملاحظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist drei Jahre in Folge zu spät, und die Hirten tun nicht mehr so, als bemerkten sie es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He has been late three years running, and the herders have stopped pretending not to notice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tres años seguidos llegando tarde, y los pastores han dejado de fingir que no lo notan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est en retard trois années de suite, et les éleveurs ont cessé de faire semblant de ne rien voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in ritardo da tre anni di fila, e i pastori hanno smesso di fingere di non accorgersene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele está atrasado três anos seguidos, e os pastores pararam de fingir que não notam."
          }
        }
      }
    },
    "He has been seven minutes slow since the war, and nobody wants to be the one to mention it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متأخر سبع دقائق منذ الحرب، ولا أحد يريد أن يكون الشخص الذي يذكر ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er geht seit dem Krieg sieben Minuten nach, und niemand will derjenige sein, der es anspricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He has been seven minutes slow since the war, and nobody wants to be the one to mention it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está siete minutos atrasado desde la guerra, y nadie quiere ser el que lo mencione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a sept minutes de retard depuis la guerre, et personne ne veut être celui qui le dit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È indietro di sette minuti dalla guerra, e nessuno vuole essere quello che lo dice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele está sete minutos atrasado desde a guerra, e ninguém quer ser quem vai comentar."
          }
        }
      }
    },
