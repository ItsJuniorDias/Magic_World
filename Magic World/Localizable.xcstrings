    "Twenty-two out. She waits on the post until twenty-two come back, however long that takes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خرجت اثنتان وعشرون. تنتظر على الوتد حتى تعود اثنتان وعشرون، مهما طال الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiundzwanzig hinaus. Sie wartet auf dem Pfosten, bis zweiundzwanzig zurück sind, so lange es dauert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty-two out. She waits on the post until twenty-two come back, however long that takes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salieron veintidós. Espera en el poste hasta que vuelvan veintidós, tarde lo que tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt-deux sortis. Elle attend sur le poteau que vingt-deux reviennent, aussi longtemps qu’il faut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventidue in uscita. Aspetta sul palo finché non ne tornano ventidue, il tempo che ci vuole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte e dois saíram. Ela espera no poste até vinte e dois voltarem, o tempo que for."
          }
        }
      }
    },
