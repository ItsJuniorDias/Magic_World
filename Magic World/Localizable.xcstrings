    "The lamp on the Scalinata has been out since March, and nobody has fixed it on purpose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lamp on the Scalinata has been out since March, and nobody has fixed it on purpose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lâmpada da Scalinata está apagada desde março, e ninguém consertou de propósito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lámpara de la Scalinata está apagada desde marzo, y nadie la ha arreglado a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lampe de la Scalinata est éteinte depuis mars, et personne ne l’a réparée exprès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lampe an der Scalinata ist seit März aus, und niemand hat sie absichtlich repariert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lampada della Scalinata è spenta da marzo, e nessuno l’ha aggiustata apposta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصباح السكالِناتا مطفأ منذ مارس، ولم يصلحه أحد عن قصد."
          }
        }
      }
    },
