    "Rui finds a shoebox under the hedge with nine evenings in it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rui finds a shoebox under the hedge with nine evenings in it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rui acha uma caixa de sapato debaixo da cerca viva com nove entardeceres dentro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rui encuentra una caja de zapatos bajo el seto con nueve atardeceres dentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rui trouve une boîte à chaussures sous la haie avec neuf soirées à l’intérieur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rui findet einen Schuhkarton unter der Hecke, mit neun Abenden darin."
