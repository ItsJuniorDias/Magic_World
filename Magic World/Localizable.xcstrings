    "The hare's map shows a road through the wood. There is no road through the wood. Not yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة الأرنب تُظهر طريقًا يعبر الغابة. لا يوجد طريق يعبر الغابة. ليس بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte des Hasen zeigt einen Weg durch den Wald. Es gibt keinen Weg durch den Wald. Noch nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hare's map shows a road through the wood. There is no road through the wood. Not yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa de la liebre muestra un camino por el bosque. No hay camino por el bosque. Aún no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte du lièvre montre une route à travers le bois. Il n’y a pas de route à travers le bois. Pas encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mappa della lepre mostra una strada nel bosco. Non c’è strada nel bosco. Non ancora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa da lebre mostra um caminho pelo bosque. Não há caminho pelo bosque. Ainda não."
          }
        }
      }
    },
