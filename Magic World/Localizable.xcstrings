    "Close the app and open it again for the new language to apply everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق ثم افتحه من جديد لتُطبَّق اللغة الجديدة في كل مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die App und öffne sie erneut, damit die neue Sprache überall greift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the app and open it again for the new language to apply everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la app y ábrela otra vez para que el nuevo idioma se aplique en todos lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
