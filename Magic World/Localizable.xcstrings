        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface tous les chapitres terminés et tous les badges. Tes favoris et ton abonnement restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella ogni capitolo che hai finito e ogni distintivo. I tuoi preferiti e il tuo abbonamento restano."
          }
        },
        "pt-BR": {
