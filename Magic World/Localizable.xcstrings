            "value": "Ein Abo deckt alle in deiner Familiengruppe ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One subscription covers everyone in your family group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción cubre a todos en tu grupo familiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul abonnement couvre tout le monde dans ton partage familial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento copre tutti nel tuo gruppo Famiglia."
          }
        },
        "pt-BR": {
