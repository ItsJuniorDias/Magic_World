    "It says hers out loud on the landing, and she has not told a single person at that school.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It says hers out loud on the landing, and she has not told a single person at that school."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela diz o dela em voz alta no patamar da escada, e ela não contou pra ninguém naquela escola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice en voz alta en el descansillo, y ella no se lo ha contado a nadie en esa escuela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle le dit à voix haute sur le palier, et elle ne l’a dit à personne à cette école."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sagt ihren laut auf dem Treppenabsatz, und sie hat es keinem an dieser Schule erzählt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo dice ad alta voce sul pianerottolo, e lei non l’ha detto a nessuno in quella scuola."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقوله بصوت عالٍ في بسطة الدرج، ولم تخبر أحدًا في تلك المدرسة به."
          }
        }
      }
    },
