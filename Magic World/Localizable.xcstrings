    "Ada works out that the bird outside her window has not touched ground since she was born.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتشف عادة أن الطائر أمام نافذتها لم يمس الأرض منذ ولادتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada rechnet aus, dass der Vogel vor ihrem Fenster seit ihrer Geburt keinen Boden berührt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada works out that the bird outside her window has not touched ground since she was born."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada averigua que el pájaro fuera de su ventana no ha tocado el suelo desde que nació."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada comprend que l’oiseau devant sa fenêtre n’a pas touché terre depuis sa naissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada scopre che l’uccello fuori dalla sua finestra non tocca terra da quando è nata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada descobre que o pássaro fora da janela dela não toca o chão desde que ela nasceu."
          }
        }
      }
    },
