          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verlorenen Handschuhe liegen alle an einem Ort, und es ist kein Versteck. Es ist ein Lager."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lost gloves are all in one place, and it is not a hiding place. It is a store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los guantes perdidos están todos en un lugar, y no es un escondite. Es un almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gants perdus sont tous au même endroit, et ce n’est pas une cachette. C’est un dépôt."
          }
        },
        "it": {
          "stringUnit": {
