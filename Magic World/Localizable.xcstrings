    "Dai's kite will not rise. Seven crows on the telephone wire have opinions about why.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طائرة داي الورقية لا ترتفع. سبعة غربان على سلك الهاتف لديها آراء في السبب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dais Drachen steigt nicht. Sieben Krähen auf dem Telefondraht haben Meinungen dazu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai's kite will not rise. Seven crows on the telephone wire have opinions about why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cometa de Dai no sube. Siete cuervos en el cable del teléfono tienen opiniones sobre el porqué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cerf-volant de Dai ne monte pas. Sept corbeaux sur le fil du téléphone ont des avis sur la raison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aquilone di Dai non si alza. Sette cornacchie sul filo del telefono hanno opinioni sul perché."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pipa de Dai não sobe. Sete corvos no fio do telefone têm opiniões sobre o motivo."
          }
        }
      }
    },
