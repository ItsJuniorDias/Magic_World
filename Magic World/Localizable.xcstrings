    "The village is six metres down. Somebody still has to remember the way to the church.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القرية على عمق ستة أمتار. لا يزال يجب على أحدٍ تذكّر الطريق إلى الكنيسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dorf liegt sechs Meter tief. Jemand muss sich noch an den Weg zur Kirche erinnern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The village is six metres down. Somebody still has to remember the way to the church."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pueblo está a seis metros bajo el agua. Alguien todavía tiene que recordar el camino a la iglesia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le village est à six mètres sous l’eau. Quelqu’un doit encore se souvenir du chemin vers l’église."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il paese è sei metri sotto. Qualcuno deve ancora ricordare la strada per la chiesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aldeia está seis metros abaixo. Alguém ainda precisa lembrar do caminho até a igreja."
          }
        }
      }
    },
    "The village plants by the hare, not by the calendar. This year the hare turned in October.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القرية تزرع تبعًا للأرنب، لا التقويم. هذا العام تحوّل الأرنب في أكتوبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dorf pflanzt nach dem Hasen, nicht nach dem Kalender. Dieses Jahr wechselte der Hase im Oktober."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The village plants by the hare, not by the calendar. This year the hare turned in October."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pueblo siembra por la liebre, no por el calendario. Este año la liebre cambió en octubre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le village plante d’après le lièvre, pas le calendrier. Cette année le lièvre a changé en octobre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il paese semina secondo la lepre, non il calendario. Quest’anno la lepre è cambiata a ottobre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aldeia planta pela lebre, não pelo calendário. Este ano a lebre mudou em outubro."
          }
        }
      }
    },
