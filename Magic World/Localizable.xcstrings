    "Payment is charged to your Apple Account. The subscription renews automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account. The subscription renews automatically unless cancelled at least 24 hours before the end of the period. Manage or cancel in Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é cobrado na sua Conta Apple. A assinatura se renova automaticamente, a menos que seja cancelada com pelo menos 24 horas de antecedência. Gerencie ou cancele nos Ajustes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se carga a tu Cuenta de Apple. La suscripción se renueva automáticamente salvo que la canceles al menos 24 horas antes del fin del periodo. Gestiónala o cancélala en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est débité de ton compte Apple. L’abonnement se renouvelle automatiquement sauf annulation au moins 24 heures avant la fin de la période. Gère ou annule dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wird über deinen Apple‑Account abgebucht. Das Abo verlängert sich automatisch, sofern es nicht mindestens 24 Stunden vor Ende der Laufzeit gekündigt wird. Verwalten oder Kündigen in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è addebitato sul tuo Account Apple. L’abbonamento si rinnova automaticamente salvo cancellazione almeno 24 ore prima della fine del periodo. Gestisci o annulla in Impostazioni."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخصم الدفع من حساب Apple الخاص بك. يتجدد الاشتراك تلقائيًا ما لم يتم إلغاؤه قبل نهاية الفترة بمدة 24 ساعة على الأقل. يمكنك الإدارة أو الإلغاء من الإعدادات."
          }
        }
      }
    },
    "No active subscription found on this Apple Account.": {
