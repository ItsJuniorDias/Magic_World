    "For two days in 1953 the pass could not find the houses, and the houses were perfectly fine.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لمدة يومين في عام 1953 لم يقدر الممرّ على إيجاد البيوت، والبيوت كانت بخير تام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Tage lang im Jahr 1953 fand der Pass die Häuser nicht, und den Häusern ging es bestens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For two days in 1953 the pass could not find the houses, and the houses were perfectly fine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante dos días de 1953 el paso no pudo encontrar las casas, y las casas estaban perfectamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant deux jours en 1953 la passe n’a pas retrouvé les maisons, et les maisons allaient parfaitement bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per due giorni nel 1953 il passo non trovò le case, e le case stavano benissimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por dois dias em 1953 a passagem não conseguiu achar as casas, e as casas estavam perfeitamente bem."
          }
        }
      }
    },
