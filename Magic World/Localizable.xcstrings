    "They go over on one night in October, and everything nobody could say goes with them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They go over on one night in October, and everything nobody could say goes with them."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas passam numa noite de outubro, e tudo que ninguém conseguiu dizer vai com elas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasan una noche de octubre, y todo lo que nadie pudo decir se va con ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles passent une nuit d’octobre, et tout ce que personne n’a su dire part avec elles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ziehen in einer Nacht im Oktober, und alles, was niemand sagen konnte, geht mit ihnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passano una notte di ottobre, e tutto ciò che nessuno ha saputo dire va con loro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعبرن ليلةً واحدة في أكتوبر، ويذهب معهنّ كلّ ما لم يستطع أحد قوله."
          }
        }
      }
    },
