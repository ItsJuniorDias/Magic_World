    "The narration couldn't be downloaded. You can keep reading meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنزيل السرد. يمكنك متابعة القراءة في هذه الأثناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erzählung konnte nicht geladen werden. Du kannst inzwischen weiterlesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The narration couldn't be downloaded. You can keep reading meanwhile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar la narración. Puedes seguir leyendo mientras tanto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger la narration. Tu peux continuer à lire en attendant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare la narrazione. Nel frattempo puoi continuare a leggere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar a narração. Você pode continuar lendo enquanto isso."
          }
        }
      }
    },
    "The narration is recorded in English only. Set the language to English in You to listen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السرد مسجَّل بالإنجليزية فقط. اضبط اللغة على الإنجليزية من «أنت» للاستماع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erzählung gibt es nur auf Englisch. Stelle die Sprache unter Du auf Englisch, um sie zu hören."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The narration is recorded in English only. Set the language to English in You to listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La narración está grabada solo en inglés. Cambia el idioma a inglés en Tú para escuchar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La narration n’existe qu’en anglais. Choisis l’anglais dans Toi pour l’écouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La narrazione è registrata solo in inglese. Imposta la lingua su inglese in Tu per ascoltarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A narração foi gravada só em inglês. Defina o idioma como inglês em Você para ouvir."
          }
        }
      }
    },
