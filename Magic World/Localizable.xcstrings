        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lâmpada da Scalinata está apagada desde março, e ninguém consertou de propósito."
          }
        }
      }
    },
    "The lane to the mill was closed in 1890. The boar still uses it.": {
