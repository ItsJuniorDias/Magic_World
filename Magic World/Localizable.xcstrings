    "Leaving the window open is how you ask. Asking has a cost that nobody mentions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترك النافذة مفتوحة هو الطلب. للطلب ثمن لا يذكره أحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fenster offen zu lassen ist die Bitte. Die Bitte hat einen Preis, den niemand erwähnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving the window open is how you ask. Asking has a cost that nobody mentions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar la ventana abierta es como se pide. Pedir tiene un coste del que nadie habla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser la fenêtre ouverte, c’est comme ça qu’on demande. Demander a un coût dont personne ne parle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare aperta la finestra è come si chiede. Chiedere ha un costo di cui nessuno parla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar a janela aberta é como se pede. Pedir tem um preço que ninguém menciona."
          }
        }
      }
    },
