    "The rule is that you may not choose what she takes. Everybody tries anyway.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule is that you may not choose what she takes. Everybody tries anyway."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra é que você não escolhe o que ela leva. Todo mundo tenta mesmo assim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla es que no puedes elegir lo que se lleva. Todos lo intentan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle est que tu ne peux pas choisir ce qu’elle prend. Tout le monde essaie quand même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel ist, dass du nicht wählen darfst, was sie nimmt. Trotzdem versucht es jeder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola è che non puoi scegliere cosa prende. Tutti ci provano lo stesso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القاعدة أنك لا تستطيع اختيار ما تأخذه. الجميع يحاول رغم ذلك."
          }
        }
      }
    },
