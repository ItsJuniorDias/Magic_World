    "Every chapter is narrated out loud, and the words light up as they're read. Follow along, or just listen with your eyes closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every chapter is narrated out loud, and the words light up as they're read. Follow along, or just listen with your eyes closed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada capítulo é narrado em voz alta, e as palavras acendem enquanto são lidas. Acompanhe, ou apenas ouça de olhos fechados."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada capítulo se narra en voz alta y las palabras se iluminan al ser leídas. Sigue el texto o escucha con los ojos cerrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chapitre est narré à voix haute, et les mots s’illuminent au fur et à mesure. Suivez le texte, ou écoutez les yeux fermés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Kapitel wird vorgelesen, und die Wörter leuchten beim Lesen auf. Lies mit oder hör einfach mit geschlossenen Augen zu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni capitolo è narrato ad alta voce e le parole si illuminano mentre vengono lette. Segui il testo o ascolta a occhi chiusi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل فصل يُروى بصوتٍ عالٍ، وتضيء الكلمات وهي تُقرأ. تابع القراءة، أو استمع بعينين مغمضتين."
          }
        }
      }
    },
    "What should we call you?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should we call you?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como podemos te chamar?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo te llamamos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment devons-nous t’appeler ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen wir dich nennen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come dobbiamo chiamarti?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بماذا نناديك؟"
          }
        }
      }
    },
    "We'll use it to welcome you back. You can skip this and stay anonymous.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll use it to welcome you back. You can skip this and stay anonymous."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usaremos para te dar as boas-vindas. Você pode pular e ficar anônimo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usaremos para darte la bienvenida. Puedes saltar este paso y quedar anónimo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l’utiliserons pour te souhaiter la bienvenue. Tu peux passer et rester anonyme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nutzen ihn, um dich zu begrüßen. Du kannst diesen Schritt überspringen und anonym bleiben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo useremo per darti il benvenuto. Puoi saltare e restare anonimo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنستخدمه للترحيب بعودتك. يمكنك تخطي هذا والبقاء مجهولًا."
          }
        }
      }
    },
