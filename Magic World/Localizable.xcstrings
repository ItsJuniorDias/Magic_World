    "Sixty-one people have seen her. There are sixty-one photographs of an empty slope.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sixty-one people have seen her. There are sixty-one photographs of an empty slope."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessenta e uma pessoas a viram. Existem sessenta e uma fotos de uma encosta vazia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesenta y una personas la han visto. Hay sesenta y una fotos de una ladera vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soixante et une personnes l’ont vue. Il y a soixante et une photos d’une pente vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einundsechzig Menschen haben sie gesehen. Es gibt einundsechzig Fotos einer leeren Flanke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessantuno persone l’hanno vista. Ci sono sessantuno fotografie di un pendio vuoto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رآها واحدٌ وستون شخصًا. توجد واحدٌ وستون صورة لمنحدر خالٍ."
          }
        }
      }
    },
