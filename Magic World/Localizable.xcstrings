          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A trilha até o moinho foi fechada em 1890. O javali ainda usa."
          }
        }
      }
    },
    "The lost gloves are all in one place, and it is not a hiding place. It is a store.": {
