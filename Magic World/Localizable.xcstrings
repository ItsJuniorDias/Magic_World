    "You give it a name at the mouth, and it takes the name to the source. That is the whole of it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعطيه اسمًا عند المصبّ فيأخذه إلى المنبع. هذا كل شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man gibt ihm an der Mündung einen Namen, und er trägt ihn zur Quelle. Das ist alles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You give it a name at the mouth, and it takes the name to the source. That is the whole of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le das un nombre en la desembocadura y lo lleva hasta la fuente. Eso es todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lui donnes un nom à l’embouchure, et il l’emporte à la source. C’est tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli dai un nome alla foce e lo porta alla sorgente. È tutto qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você dá um nome na foz, e ele leva o nome até a nascente. É só isso."
          }
        }
      }
    },
