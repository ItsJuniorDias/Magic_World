    "Each story downloads the first time you open it. After that, no connection needed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزّل كل قصة عند فتحها لأول مرة. بعد ذلك، لا حاجة إلى اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Geschichte wird beim ersten Öffnen geladen. Danach ohne Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each story downloads the first time you open it. After that, no connection needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada historia se descarga la primera vez que la abres. Después, no hace falta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque histoire se télécharge lors de la première ouverture. Ensuite, plus besoin de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni storia si scarica alla prima apertura. Dopo, nessuna connessione richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada história baixa na primeira vez que você abre. Depois disso, sem conexão."
          }
        }
      }
    },
    "Eight Shelves": {
