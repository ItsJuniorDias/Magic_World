    "The year the river came into the streets, a bird made of glass stood on Wren's roof and would not leave.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The year the river came into the streets, a bird made of glass stood on Wren's roof and would not leave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No ano em que o rio invadiu as ruas, um pássaro de vidro pousou no telhado de Wren e não quis sair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El año en que el río entró en las calles, un pájaro de cristal se posó en el tejado de Wren y no quiso irse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’année où la rivière est entrée dans les rues, un oiseau de verre s’est posé sur le toit de Wren et n’a pas voulu partir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dem Jahr, als der Fluss in die Straßen kam, saß ein gläserner Vogel auf Wrens Dach und wollte nicht weg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anno in cui il fiume entrò nelle strade, un uccello di vetro si posò sul tetto di Wren e non volle andarsene."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في السنة التي دخل فيها النهر إلى الشوارع، وقف طائر من زجاج على سطح رِن ولم يرحل."
          }
        }
      }
    },
